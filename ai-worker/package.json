{
  "name": "rezumate-ai-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply rezumate-ai --local",
    "db:migrate:remote": "wrangler d1 migrations apply rezumate-ai --remote",
    "eval": "npm run db:migrate:local && node scripts/eval.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.7",
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true
  }
}
