rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /waitlist/{emailId} {
      allow create: if request.resource.data.keys().hasOnly(['email', 'createdAt', 'source', 'referrer'])
        && request.resource.data.email is string
        && request.resource.data.email.lower() == emailId
        && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[A-Za-z]{2,}$')
        && request.resource.data.email.size() < 200
        && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/waitlist/$(emailId));

      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
